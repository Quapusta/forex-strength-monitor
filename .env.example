# cTrader Open API credentials. Never commit real values.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
CTRADER_REFRESH_TOKEN=

# Local development storage. In Cloud Run, point this to a persistent database.
DATABASE_PATH=data/forex_strength.sqlite3

# Independent USD crosses are sufficient to rank these eight currencies.
FOREX_PAIRS=EURUSD,GBPUSD,AUDUSD,NZDUSD,USDJPY,USDCHF,USDCAD
